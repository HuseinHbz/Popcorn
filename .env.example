# Copy to .env and replace every "change-me" value. Never commit .env.
# Placeholders only. With APP_ENV=production the app refuses to start on any "change-me",
# a database or Redis password under 16 characters, an S3 secret under 32 characters, any of
# those with fewer than 8 distinct characters, or plain http to a non-local S3 endpoint.

# --- Docker Compose (local services) ---
COMPOSE_FILE=docker-compose.dev.yml

POSTGRES_DB=popcorn
POSTGRES_USER=popcorn
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# The app connects as this non-superuser role; POSTGRES_USER is for migrations only.
APP_DB_USER=popcorn_app
APP_DB_PASSWORD=change-me-too

REDIS_PASSWORD=change-me
REDIS_PORT=6379

S3_PORT=8333

# --- Application (validated at start-up by src/shared/config/env.ts) ---
# Required: development | test | production (no default, so production is never implied).
# In production, set APP_ENV in the deploy unit itself, not in a copy of this file.
APP_ENV=development
DATABASE_URL=postgres://popcorn_app:change-me-too@127.0.0.1:5432/popcorn
REDIS_URL=redis://:change-me@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=popcorn-media
S3_ACCESS_KEY=popcorn
S3_SECRET_KEY=change-me-s3-secret

# --- Migrations (Phase 2; not read by the app) ---
MIGRATION_DATABASE_URL=postgres://popcorn:change-me@127.0.0.1:5432/popcorn
