{
  "name": "popcorn-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Website and admin platform for Popcorn Group — Nakaya, em. café and Izakaya.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings=0 . && node scripts/check-raw-colors.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "unrs-resolver"
    ],
    "overrides": {
      "@lhci/cli>tmp": "0.2.7",
      "external-editor>tmp": "0.2.7",
      "get-uri>basic-ftp": "6.2.3",
      "@lhci/cli>uuid": "11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-7pqw-9j4j-h8q3",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
